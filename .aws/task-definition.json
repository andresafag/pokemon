{
  "family": "pokemon",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::688567305851:role/pokemon-ecs-execution-role",
  "taskRoleArn": "arn:aws:iam::688567305851:role/pokemon-ecs-task-role",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "containerDefinitions": [
    {
      "name": "pokemon",
      "image": "nginx:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 10000,
          "hostPort": 10000,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/pokemon",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "environment": [],
      "secrets": []
    }
  ]
}
