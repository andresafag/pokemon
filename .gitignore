# =============================================================================
# Node.js / src
# =============================================================================
src/node_modules/
src/npm-debug.log*
src/yarn-debug.log*
src/yarn-error.log*
src/.env
src/.env.*
!src/.env.example

# =============================================================================
# Node.js (root-level, in case deps are ever installed at root)
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# =============================================================================
# Environment & secrets
# =============================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/

# =============================================================================
# Terraform
# =============================================================================

# Local state — never commit; use the S3 backend
infrastructure/terraform/.terraform/
infrastructure/terraform/terraform.tfstate
infrastructure/terraform/terraform.tfstate.backup
infrastructure/terraform/.terraform.tfstate.backup

# Variable files often contain secrets
infrastructure/terraform/*.tfvars
infrastructure/terraform/*.tfvars.json
!infrastructure/terraform/example.tfvars

# Crash / override files
infrastructure/terraform/crash.log
infrastructure/terraform/override.tf
infrastructure/terraform/override.tf.json
infrastructure/terraform/*_override.tf
infrastructure/terraform/*_override.tf.json

# Plan output (may contain sensitive values)
infrastructure/terraform/*.tfplan

# =============================================================================
# Docker
# =============================================================================
*.tar

# =============================================================================
# OS / editor noise
# =============================================================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
